{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransactionsSyncV1",
  "type": "object",
  "required": ["endpoint", "method", "headers", "request_body"],
  "properties": {
    "endpoint": { "type": "string" },
    "method": { "type": "string", "enum": ["POST"] },
    "host": { "type": "string" },
    "headers": {
      "type": "object",
      "required": ["Authorization", "Content-Type", "Accept", "X-Correlation-ID"]
    },
    "request_body": {
      "type": "object",
      "required": ["account_ids", "options", "cursor", "date_range"],
      "properties": {
        "account_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "options": {
          "type": "object",
          "properties": {
            "include_pending": { "type": "boolean" },
            "personal_finance_category": { "type": "boolean" }
          }
        },
        "cursor": { "type": "string" },
        "date_range": {
          "type": "object",
          "required": ["start_date", "end_date"],
          "properties": {
            "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    }
  }
}
